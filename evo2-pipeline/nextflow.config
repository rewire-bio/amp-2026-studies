// The Evo 2 study image, pinned by digest, and the Hugging Face cache for its verified weights.
params.evo2_image = 'ghcr.io/rewire-bio/evo2-cloud-operations@sha256:22970720ff8bc05a00460a6066a70ed71951001aa52965141591a0ca6dcc968b'
params.hf_cache   = "${projectDir}/.hf-cache"

profiles {
    // Laptop: local bcftools and python3; Evo 2 scores replayed from a recorded H100 run.
    replay {
        params.evo2_recorded = "${projectDir}/resources/evo2_7b_h100_brca1.tsv"
    }

    // A GPU host with Docker. Only SCORE_EVO2 needs the GPU and the Evo 2 image.
    gpu {
        docker.enabled = true
        process {
            withLabel: gpu {
                container      = params.evo2_image
                accelerator    = 1
                memory         = '64 GB'
                time           = '3h'
                containerOptions = "--gpus all --ipc=host -v ${params.hf_cache}:/hf -e HF_HOME=/hf"
                maxForks       = 1
            }
        }
    }
}

process.errorStrategy = 'terminate'
