# Bulk downloads stay local (each is re-downloaded by the script that reads it); the case files, per-case scores
# and run logs derived from them are committed
rare-disease/data/avi
rare-disease/data/am
rare-disease/data/clinvar.vcf.gz
rare-disease/data/clinvar_snv_panel.tsv
rare-disease/data/**/*.tbi
rare-disease/data/**/*.csi
# CADD and REVEL are free for non-commercial use but not for redistribution: lookup_scores.py fetches them
rare-disease/data/**/scores_cadd.tsv
rare-disease/data/**/scores_revel.tsv
rare-disease/evo2/data*/
brca1-case-ranking/avi_*.tsv
brca1-case-ranking/brca1_hg38.tsv
rare-disease/figures/out/
evee/out/
# Run secrets and raw pod output
rare-disease/evo2/run*/.ssh-key*
rare-disease/evo2/run*/.known_hosts
rare-disease/evo2/run*/ref_scores.tsv
rare-disease/evo2/run*/var_scores.tsv
rare-disease/evo2/run*/score.log
# Nextflow
evo2-pipeline/resources/
evo2-pipeline/results/
evo2-pipeline/work/
evo2-pipeline/.nextflow*
evo2-pipeline/.hf-cache/
__pycache__/
.DS_Store
gpu-drift/out/
# rare-disease-v2: same rules as rare-disease, plus the local EVEE table
rare-disease-v2/data/**/scores_cadd.tsv
rare-disease-v2/data/**/scores_revel.tsv
rare-disease-v2/data/**/*.tbi
rare-disease-v2/data/**/*.csi
rare-disease-v2/data/evee/
rare-disease-v2/figures/out/
rare-disease-v2/data/spliceai/hg38.fa*
rare-disease-v2/data/gnomad_subset/
